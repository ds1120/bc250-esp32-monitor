[Unit]
Description=BC250 ESP32 emergency internet alongside Bluetooth
After=bc250-esp-bluetooth.service NetworkManager.service
Requires=bc250-esp-bluetooth.service NetworkManager.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/bc250/esp_network.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
User=root
UMask=0077
RuntimeDirectory=bc250-esp-network
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
